# Porta publicada no host (escolha uma livre; evita conflito com a outra aplicacao)
PANEL_PORT=8080
# Porta interna da aplicacao dentro do container
PORT=3000
# Caminho do SQLite; deve ficar dentro do volume montado em /data
DB_PATH=/data/panel.sqlite
# Segredo do painel (minimo 32 bytes)
PANEL_SECRET=troque-por-um-segredo-longo-com-32-bytes-ou-mais
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
